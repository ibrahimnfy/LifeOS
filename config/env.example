# LifeOS personal settings — template.
#
# Copy to ~/.config/lifeos/env and fill in. That folder lives outside the
# repository and must stay private:
#
#   mkdir -p ~/.config/lifeos && chmod 700 ~/.config/lifeos
#   cp config/env.example ~/.config/lifeos/env && chmod 600 ~/.config/lifeos/env
#
# Format: KEY=value, one per line, no quotes needed, `#` starts a comment.
# Never commit the real file. Every variable the project reads is listed here.

# (No variables are required yet. scripts/notify.sh needs no configuration.)
