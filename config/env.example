# LifeOS personal settings — template.
#
# Copy to ~/.config/lifeos/env and fill in. That folder lives outside the
# repository and must stay private:
#
#   mkdir -p ~/.config/lifeos && chmod 700 ~/.config/lifeos
#   cp config/env.example ~/.config/lifeos/env && chmod 600 ~/.config/lifeos/env
#
# Format: KEY=value, one per line, no quotes needed, `#` starts a comment.
# Never commit the real file. Every variable the project reads is listed here.

# --- Bridge -----------------------------------------------------------------

# Secret the phone app and scripts/ask send as `Authorization: Bearer <token>`.
# Required, at least 32 characters. Generate it with scripts/init-config.sh
# (which fills this line in your private copy); never write a real token here.
LIFEOS_BRIDGE_TOKEN=

# Address the bridge listens on. Only localhost or this machine's Tailscale
# address are accepted; wildcard and public addresses are refused.
LIFEOS_BRIDGE_HOST=127.0.0.1

# Port the bridge listens on (1024-65535).
LIFEOS_BRIDGE_PORT=8787

# --- Asking Claude ------------------------------------------------------------

# Folder in which prompts from the phone run. Claude can read files inside
# this folder only. Default: ~/brain
LIFEOS_ASK_DIR=~/brain

# Seconds before a run is stopped (5-3600).
LIFEOS_ASK_TIMEOUT=300

# How many Claude runs may be active at the same time (1-16).
LIFEOS_MAX_CONCURRENT=2

# Upper limit of agent turns per prompt (1-200).
LIFEOS_MAX_TURNS=25

# Path or name of the Claude Code command. Default: claude (looked up in PATH)
LIFEOS_CLAUDE_BIN=claude

# Model alias or name for runs started by the bridge. Empty = Claude Code's default.
LIFEOS_CLAUDE_MODEL=
