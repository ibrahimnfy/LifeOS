# LifeOS personal settings — template.
#
# Copy to ~/.config/lifeos/env and fill in. That folder lives outside the
# repository and must stay private:
#
#   mkdir -p ~/.config/lifeos && chmod 700 ~/.config/lifeos
#   cp config/env.example ~/.config/lifeos/env && chmod 600 ~/.config/lifeos/env
#
# Format: KEY=value, one per line, no quotes needed, `#` starts a comment.
# Never commit the real file. Every variable the project reads is listed here.

# --- Bridge -----------------------------------------------------------------

# Secret the phone app and scripts/ask send as `Authorization: Bearer <token>`.
# Required, at least 32 characters. Generate it with scripts/init-config.sh
# (which fills this line in your private copy); never write a real token here.
LIFEOS_BRIDGE_TOKEN=

# Address the bridge listens on. Only the loopback interface is accepted
# (127.0.0.1, ::1, localhost); everything else is refused. The phone does not
# connect to this address: it arrives through the relay (docs/security.md).
LIFEOS_BRIDGE_HOST=127.0.0.1

# Port the bridge listens on (1024-65535).
LIFEOS_BRIDGE_PORT=8787

# Only for scripts/ask: full address of the bridge when it is not
# http://<LIFEOS_BRIDGE_HOST>:<LIFEOS_BRIDGE_PORT> (e.g. from another machine).
# LIFEOS_BRIDGE_URL=

# --- Asking Claude ------------------------------------------------------------

# The memory folder. The coach conversation and conversations started in
# this folder by name run here; a new chat without a folder runs in a folder
# of its own under LIFEOS_CHAT_DIR instead. Default: ~/brain
LIFEOS_ASK_DIR=~/brain

# Folder under which every blank chat gets its own new folder
# (<date>-<short id>). The bridge creates it. It must be inside the home
# folder and outside the memory folder, every allowed folder and every git
# repository, and it must hold no CLAUDE.md; otherwise blank chats are refused.
# Default: ~/LifeOS-Chats
LIFEOS_CHAT_DIR=~/LifeOS-Chats

# Seconds before a run is stopped (5-3600).
LIFEOS_ASK_TIMEOUT=300

# How many Claude runs may be active at the same time (1-16).
LIFEOS_MAX_CONCURRENT=2

# Upper limit of agent turns per prompt (1-200).
LIFEOS_MAX_TURNS=25

# Script the bridge calls to notify the owner. Default: scripts/notify.sh of
# this repository. `off` switches the bridge's notifications off.
#LIFEOS_NOTIFY_SCRIPT=

# Path or name of the Claude Code command. Default: claude (looked up in PATH)
# Both runners start this installed command; the copy of Claude Code bundled
# in the Agent SDK package is never used.
LIFEOS_CLAUDE_BIN=claude

# How conversations run: `cli` starts `claude -p` for every message (default);
# `sdk` keeps one Agent SDK client per active conversation between messages
# (read-only runs only; the capable mode is off with `sdk` until the guardrail
# checks pass on it). Sign-in is the existing login of the installed Claude Code.
LIFEOS_RUNNER=cli

# SDK runner only: minutes a conversation's process stays alive after its last
# message (1-1440), and how many may be alive at once (1-16; when another one
# is needed, the longest-idle is closed first). Closing loses nothing: the
# next message resumes the conversation from its transcript.
LIFEOS_SDK_IDLE_MINUTES=15
LIFEOS_SDK_MAX_LIVE=3

# SDK runner only: seconds a question or approval from a run waits for the
# owner's answer (30-3600). No answer in time counts as "no".
LIFEOS_INTERACTION_TIMEOUT=600

# After an update of Claude Code or the Agent SDK the capable mode goes off
# and the guardrail check reruns by itself (about twenty short runs on the
# Claude plan per update). `off` stops only the automatic rerun; the mode
# still goes off, and scripts/verify-guardrails must then be run by hand.
#LIFEOS_GUARD_AUTOCHECK=

# Where the bridge keeps the copies of skills that capable runs are started
# with. A run may read its own copies there and never write them. Must lie in
# the home folder, outside the private settings folder, the allowed folders,
# the memory folder and every git repository.
# Default: ~/.local/share/lifeos/skill-copies
#LIFEOS_SKILL_COPIES_DIR=

# Model and effort a conversation uses unless it names its own (the app can
# change both per session). An alias always means the latest model of that
# family. Effort levels are whatever the installed Claude Code accepts.
LIFEOS_DEFAULT_MODEL=opus
LIFEOS_DEFAULT_EFFORT=high

# Model names the app offers, comma-separated. The Claude Code command has no
# way to list models, so this list is kept here; a run fails cleanly if a name
# is not accepted.
LIFEOS_MODELS=opus,sonnet,haiku,fable

# Model per job of the bridge's own runs: `job=model[/effort][+advisor]`, separated
# by commas. Empty = the defaults:
#   coach_plan=opus/high, coach_chat=opus/high (coach morning run and refresh; coach
#   conversation), consolidation, course_resources, summaries, context_map =
#   sonnet+opus (Sonnet does the work and may consult Opus at hard steps through
#   Claude Code's --advisor). `+none` switches the advisor off; `chat` sets the
#   default of chat sessions (each session can still choose its own). Model names
#   are the CLI's aliases (opus, sonnet, haiku, fable: always the latest of the
#   family) or full names such as claude-sonnet-5-5. GET /models/routing shows
#   the result and the plan usage per job.
LIFEOS_MODEL_ROUTING=

# Older single setting, still honoured: when set, it is the model of every
# background job that LIFEOS_MODEL_ROUTING does not name (without advisor). If it
# is set from before, the coach no longer runs on Opus: empty it, or name the
# coach jobs in LIFEOS_MODEL_ROUTING.
LIFEOS_BACKGROUND_MODEL=

# Forces one model for every run, overriding all of the above. Leave empty.
LIFEOS_CLAUDE_MODEL=

# Largest file the assistant may send to the phone, in MB (1-200).
LIFEOS_MAX_FILE_MB=50

# --- Moodle -----------------------------------------------------------------

# Base address of the university Moodle, without a trailing slash. Written by
# the owner into the private copy only; never put a real address here.
#MOODLE_URL=

# Web-service token. Never write it by hand: scripts/moodle-login stores it
# after the owner signed in through the browser.
#MOODLE_TOKEN=

# Written by scripts/moodle-login together with the token; never by hand.
# The day the token was saved (YYYY-MM-DD); the bridge uses it to warn before
# the sign-in expires (an estimate: the site does not tell the expiry date).
#MOODLE_TOKEN_SAVED=

# The sign-in button chosen at the first run: its number on the site, or
# `none` for the site's own login form. `scripts/moodle-login --choose` asks
# again.
#MOODLE_LOGIN_ISSUER=

# The owner's course folder (absolute path, or starting with ~). The course
# sync keeps one folder per course in it: downloaded materials, links.md,
# announcements.md, grades.md. It must exist and be an allowed folder
# (allowed_paths). Without it nothing is synced. Private copy only.
#MOODLE_DOWNLOAD_DIR=

# Largest single file the course sync downloads, in MB. One sync fetches at
# most 1 GB and 200 files in total; the rest follows in the next syncs.
#LIFEOS_MOODLE_MAX_FILE_MB=200

# Course resources from the syllabus: largest single PDF or EPUB file the bridge
# downloads, in MB (1 to 2000), enforced while downloading. Any public HTTPS
# host is used; piracy sources never, paid books are listed only.
# LIFEOS_RESOURCE_HOSTS (the old host allow-list) is no longer read.
# The owner's existing resource folders are not set here but in
# ~/.config/lifeos/resource_folders, one absolute path per line (an empty file
# means "none"); until that file exists nothing is downloaded automatically.
# The owner's own course folders (#179) are not set here either but in
# ~/.config/lifeos/course_folders, one "<Moodle course id><TAB><absolute path>"
# per line: read-only context of that course's chats (never written, never a
# working folder, never in the app's course materials), and counted as existing
# resource folders once resource_folders exists.
#LIFEOS_RESOURCE_MAX_FILE_MB=200
