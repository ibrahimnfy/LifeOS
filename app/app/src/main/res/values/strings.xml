    <!-- Pairing -->
    <string name="pair_title">Pair with computer</string>
    <string name="pair_intro">Pairing connects this phone to your computer. It is done once.</string>
    <string name="pair_step_1">On your computer, run:</string>
    <string name="pair_command">lifeos-bridge pair \"My phone\"</string>
    <string name="pair_step_2">Scan the QR code it shows. The code is the key: show it to nobody else.</string>
    <string name="pair_step_3">Compare the six-digit code on both screens and confirm on the computer.</string>
