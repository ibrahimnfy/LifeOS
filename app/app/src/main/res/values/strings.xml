    <string name="pair_camera_why">The camera is used only to read the pairing code. Nothing is recorded or stored.</string>
    <string name="pair_camera_denied">Without the camera the code cannot be read. Allow camera access for LifeOS in the phone\'s settings, then try again.</string>
