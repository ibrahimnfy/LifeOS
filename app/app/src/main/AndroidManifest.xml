<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Outbound HTTPS to the relay only; the app opens no port. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to read the pairing QR code; asked for when the owner starts pairing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Screen time and per-app use; granted by the owner in the system settings ("usage access"). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The silent morning question about last night's sleep: a notification (asked for on
         Android 13 and newer) and planning it again after the phone restarts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The "update ready" prompt (#138): hands a verified release of this same app to Android's
         installer. Android asks the owner to allow it ("install unknown apps") the first time;
         every install is confirmed on the system's own screen. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- App names for screen time: only apps with an icon on the home screen, and the home screen itself. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".LifeOsApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeOS"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" from other apps: text or a link goes into the capture sheet. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Long-press on the app icon: "Capture". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Moodle sign-in from the phone (#100): receives the moodlemobile://token=… address the
             site's page ends on (the scheme the site uses for the official app), hands it on and
             closes. No screen of its own. -->
        <activity
            android:name=".signin.MoodleRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moodlemobile" />
            </intent-filter>
        </activity>

        <!-- Push (#38): Firebase data messages, opened with the push key; not reachable by other apps. -->
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The morning question's alarm, a restart of the phone, a change of clock or time zone.
             Not exported: only the system and the app itself reach it. -->
        <receiver
            android:name=".activity.SleepPromptReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The installer's answers to an update (#138). Not exported: reached only through the
             app's own PendingIntent. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Lets AppCompat remember the chosen app language on Android 12 and older. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
