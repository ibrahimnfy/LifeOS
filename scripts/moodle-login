#!/usr/bin/env bash
# Sign in to the university Moodle through the browser and store a token in
# the private config folder. The password is typed only on the institution's
# own page; this helper never sees it.
# Usage: scripts/moodle-login                 sign in and store the token
#        scripts/moodle-login --check         test the stored token
#        scripts/moodle-login --choose        ask for the sign-in button again
#        scripts/moodle-login --no-handler    register nothing; paste the address by hand
set -euo pipefail
bridge_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bridge" && pwd)"
cd "$bridge_dir"
if [ -x .venv/bin/python ]; then
  exec .venv/bin/python -m lifeos_bridge.moodle_login "$@"
elif command -v uv >/dev/null 2>&1; then
  exec uv run python -m lifeos_bridge.moodle_login "$@"
fi
echo "error: bridge/.venv is missing and 'uv' is not installed (see docs/bridge.md, Setup)." >&2
exit 2
