#!/usr/bin/env bash
# Guardrail check for the capable mode: runs probes of docs/permission-policy.md
# against the real Claude Code through the Agent SDK runner. A pass writes the
# marker that keeps the capable mode on; a failed guardrail probe switches it
# off; a check that does not complete changes nothing (#181).
#
# Usage: scripts/verify-guardrails [--full] [--no-service]
#   (default) the core set: about 9 short runs, in this environment
#   --full    the full suite: about 27 short runs here and as many again in
#             the service environment (--no-service skips that; no marker then)
set -euo pipefail
bridge_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bridge" && pwd)"
cd "$bridge_dir"
if [ -x .venv/bin/python ]; then
  exec .venv/bin/python -m lifeos_bridge.verify "$@"
elif command -v uv >/dev/null 2>&1; then
  exec uv run python -m lifeos_bridge.verify "$@"
fi
echo "error: bridge/.venv is missing and 'uv' is not installed (see docs/bridge.md, Setup)." >&2
exit 2
